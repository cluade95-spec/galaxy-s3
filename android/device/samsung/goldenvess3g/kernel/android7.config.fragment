# Candidate kernel options for Android 7.1.2 on the GT-I8200 kernel.  NOT APPLIED, NOT BUILD-TESTED.
# Format: CONFIG_X=value  # status: reason.  "unverified" means the need is expected but no test has run.
#
# Evidence: docs/phase-1-sm-t110-analysis.md section 3.3 (SM-T110 port config), docs/phase-2-kernel-build.md.

# --- Networking (Android 7 netd) ---------------------------------------------------------
CONFIG_NETFILTER_XT_MARK=m                 # unverified: off in golden_rev02, on in the SM-T110 port
CONFIG_NETFILTER_XT_CONNMARK=m             # unverified: same
CONFIG_NETFILTER_XT_MATCH_MARK=m           # unverified
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m       # unverified
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m      # unverified
CONFIG_NETFILTER_XT_TARGET_MARK=m          # unverified
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m      # unverified
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m     # unverified
# CONFIG_NETFILTER_XT_MATCH_OWNER:         # TODO: off in both configs; whether Android 7.1 netd needs it is UNKNOWN
# UID-range routing: needs the kernel-uid-routing patch (dry-run applies cleanly to this tree, Phase 1). TODO: carry as a
# recorded patch outside the original source.

# --- Security ------------------------------------------------------------------------------
# TODO(selinux): stock kernel has CONFIG_SECURITY off. Decide between building SELinux in (permissive first) and running
# without it as the SM-T110 port does. Candidate options if SELinux is built in:
#   CONFIG_SECURITY=y  CONFIG_SECURITY_SELINUX=y  CONFIG_AUDIT=y  CONFIG_EXT4_FS_SECURITY=y  CONFIG_TMPFS_XATTR=y(already on)
# SEC_RESTRICT_*: leave OFF (plain defconfig).  [DECISION pending]

# --- Already satisfied in pxa986_golden_rev02_defconfig (VERIFIED in the generated .config) ----
# CONFIG_ANDROID_BINDER_IPC=y (protocol 7; Android 7 libbinder is built with BINDER_IPC_32BIT=1, which selects protocol 7)
# CONFIG_ASHMEM=y  CONFIG_ION=y  CONFIG_ANDROID_LOW_MEMORY_KILLER=y  CONFIG_IP_MULTIPLE_TABLES=y
# CONFIG_NETFILTER_XT_MATCH_QTAGUID=y  CONFIG_ANDROID_PARANOID_NETWORK=y  CONFIG_FUSE_FS=y  CONFIG_ZRAM=y

# --- Not enabled, no evidence they are required ---------------------------------------------
# cgroups are off in the stock config; the SM-T110 port reports booting without them (CLAIMED).
