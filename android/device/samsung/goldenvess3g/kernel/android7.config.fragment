# Candidate kernel options for Android 7.1.2 on the GT-I8200 kernel.  NOT APPLIED, NOT BUILD-TESTED.
# Format: CONFIG_X=value  # status: reason.  "unverified" means the need is expected but no test has run.
#
# Evidence: docs/phase-1-sm-t110-analysis.md section 3.3 (SM-T110 port config), docs/phase-2-kernel-build.md.

# --- Networking (Android 7 netd) ---------------------------------------------------------
CONFIG_NETFILTER_XT_MARK=m                 # unverified: off in golden_rev02, on in the SM-T110 port
CONFIG_NETFILTER_XT_CONNMARK=m             # unverified: same
CONFIG_NETFILTER_XT_MATCH_MARK=m           # unverified
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m       # unverified
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m      # unverified
CONFIG_NETFILTER_XT_TARGET_MARK=m          # unverified
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m      # unverified
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m     # unverified
# CONFIG_NETFILTER_XT_MATCH_OWNER:         # TODO: off in both configs; whether Android 7.1 netd needs it is UNKNOWN
# UID-range routing: needs the kernel-uid-routing patch (dry-run applies cleanly to this tree, Phase 1). TODO: carry as a
# recorded patch outside the original source.

# --- Security ------------------------------------------------------------------------------
# SELinux is a HARD REQUIREMENT for Android 7.1.2's init, not an optional decision (Phase 6, SOURCE + config):
#  * The plain defconfig has CONFIG_SECURITY off. Android 7's init (system/core/init/init.cpp, selinux_initialize) calls
#    selinux_android_load_policy() and aborts through security_failure() if it fails, which it must without SELinux.
#  * Options needed in the kernel: CONFIG_SECURITY=y CONFIG_SECURITY_NETWORK=y CONFIG_AUDIT=y CONFIG_SECURITY_SELINUX=y
#    (Kconfig: SECURITY_SELINUX depends on SECURITY_NETWORK && AUDIT && NET && INET) and CONFIG_EXT4_FS_SECURITY=y so file
#    labels can be stored. security/selinux exists in the pinned source.
#  * BLOCKER: this kernel's SELinux supports policy versions up to 26 (security/selinux/include/security.h,
#    POLICYDB_VERSION_ROLETRANS). Android 7.1.2's sepolicy is compiled at version 30 by default (system/sepolicy
#    Android.mk, POLICYVERS ?= 30) and the platform policy uses `allowxperm` / `neverallowxperm` rules (ioctl extended
#    permissions, introduced with policy version 30). A kernel at version 26 cannot load that policy. Raising the
#    kernel's accepted maximum by configuration is not enough because the xperm code is absent. Options (none applied):
#      (a) back-port ioctl extended permissions into the kernel (a kernel source change: needs its own approval and review);
#      (b) alter the platform policy to drop the xperm rules and build at version 26 (weakens policy; unverified that it
#          compiles; not run);
#      (c) run without SELinux, as the SM-T110 port does with an init patch plus selinux=0 on the command line. That
#          DISABLES a core Android security feature. It is only acceptable as an explicit, documented owner decision
#          for a bring-up build, never as a silent default. Not applied.
#  Phase 7 update: option (a) is the recommended one. Google's android-3.4 SELinux/LSM code applied to a separate copy of
#  this kernel compiles (not run). Policy compiles at version 30 and fails at 26 to 29 only because of the 5 allowxperm rules;
#  deleting them would widen access, so (b) is rejected. See docs/phase-7-selinux-compatibility.md.
# SEC_RESTRICT_*: leave OFF (plain defconfig).  [DECISION pending]

# --- Already satisfied in pxa986_golden_rev02_defconfig (VERIFIED in the generated .config) ----
# CONFIG_ANDROID_BINDER_IPC=y (protocol 7; Android 7 libbinder is built with BINDER_IPC_32BIT=1, which selects protocol 7)
# CONFIG_ASHMEM=y  CONFIG_ION=y  CONFIG_ANDROID_LOW_MEMORY_KILLER=y  CONFIG_IP_MULTIPLE_TABLES=y
# CONFIG_NETFILTER_XT_MATCH_QTAGUID=y  CONFIG_ANDROID_PARANOID_NETWORK=y  CONFIG_FUSE_FS=y  CONFIG_ZRAM=y

# --- Not enabled, no evidence they are required ---------------------------------------------
# cgroups are off in the stock config; the SM-T110 port reports booting without them (CLAIMED).
