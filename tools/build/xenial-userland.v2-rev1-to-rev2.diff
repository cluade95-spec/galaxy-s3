+wait_no_procs() {   # wait_no_procs ROOT SECONDS
+  local i; for ((i = 0; i < $2 * 5; i++)); do [ -z "$(chroot_pids "$1" | awk '$2=="root"')" ] && return 0; sleep 0.2; done; return 1
