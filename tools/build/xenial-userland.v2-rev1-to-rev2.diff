+# ---------------------------------------------------------------- processes, signals, mounts
+CHILD=""; SIGNAL_SEEN=""; SESSION_MOUNTED=""; FETCH_TMP=""; PARTIAL_ROOT=""; INT_POLICY=abort; KILL_LEFTOVERS=""
