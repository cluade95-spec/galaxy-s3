+mount_chroot() {   # proc + a MINIMAL private /dev (never the host's /dev): null zero full random urandom tty, pts, shm, fd links
+  local n
+  SESSION_MOUNTED=1
+  mount -t proc proc "$ROOT/proc"
+  mount -t tmpfs -o mode=755,nosuid,noexec,size=2m tmpfs "$ROOT/dev"
