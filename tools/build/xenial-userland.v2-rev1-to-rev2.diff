+kill_chroot_procs() {   # kill_chroot_procs ROOT [GRACE_SECONDS] : TERM, wait, then KILL; only processes whose ROOT is inside the chroot
+  local r="$1" grace="${2:-8}" pids i
+  pids=$(chroot_pids "$r" | awk '$2=="root"{print $1}')
