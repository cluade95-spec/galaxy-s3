# PROPOSED, NOT APPLIED to the pinned kernel (Phase 9). Adapted by hand for the 3.4.5 Samsung binder.c from the upstream change(s) named below.
# Tested only in a disposable copy: compiles for ARM and passes the Phase 8 QEMU binder test set. Not exploit-tested.
# Upstream: f5cb779ba16334b45ba8946d6bfa6d9834d1527f ('ANDROID: binder: remove waitqueue when thread exits') and
# 5eeb2ca02a2f6084fc57ae5c244a38baab07033a ('ANDROID: binder: synchronize_rcu() when using POLLFREE'); Google carried them in kernel/common
# deprecated/android-3.18 as a4b334e1f and 1a19138f4. Those do not apply to this older binder (see docs/phase-9-binder-fixes.md);
# this is a hand adaptation. The 3.4 code has no 'thread used poll' flag, so waitqueue_active() is the condition.
# Fixes a use-after-free: an epoll watch on a binder fd keeps a pointer into a binder_thread that BINDER_THREAD_EXIT frees.

--- a/drivers/staging/android/binder.c
+++ b/drivers/staging/android/binder.c
@@ -2663,6 +2663,14 @@
 	if (send_reply)
 		binder_send_failed_reply(send_reply, BR_DEAD_REPLY);
 	binder_release_work(&thread->todo);
+	/*
+	 * binder_poll() hands thread->wait to epoll. Before the thread is freed, make epoll drop it (POLLFREE) and wait for
+	 * readers of the epoll wait list (RCU) so that no stale pointer to the freed waitqueue remains.
+	 */
+	if (waitqueue_active(&thread->wait)) {
+		wake_up_poll(&thread->wait, POLLHUP | POLLFREE);
+		synchronize_rcu();
+	}
 	kfree(thread);
 	binder_stats_deleted(BINDER_STAT_THREAD);
 	return active_transactions;
